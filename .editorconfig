root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,rs}]
indent_size = 4

[packages/core/test/fixtures/**]
indent_size = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
