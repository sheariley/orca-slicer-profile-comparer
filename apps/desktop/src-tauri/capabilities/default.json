{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Read-only access to OrcaSlicer's data folder ($CONFIG/OrcaSlicer).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$CONFIG/OrcaSlicer" }, { "path": "$CONFIG/OrcaSlicer/**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$CONFIG/OrcaSlicer" }, { "path": "$CONFIG/OrcaSlicer/**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$CONFIG/OrcaSlicer/**" }]
    }
  ]
}
